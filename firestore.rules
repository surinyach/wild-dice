rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /games/{gameId} {
      function playerPath(uid) {
        return /databases/$(database)/documents/games/$(gameId)/players/$(uid);
      }

      function hasValidGameFields() {
        return request.resource.data.keys().hasAll([
          "code", "status", "hostUid", "playerCount", "currentRound",
          "totalRounds", "selectedChallengeType", "selectedPlayerUids",
          "selectedChallengeId", "createdAt", "updatedAt"
        ]) && request.resource.data.keys().hasOnly([
          "code", "status", "hostUid", "playerCount", "currentRound",
          "totalRounds", "selectedChallengeType", "selectedPlayerUids",
          "selectedChallengeId", "createdAt", "updatedAt"
        ]);
      }

      function isJoining() {
        let uid = request.auth.uid;
        let previousCount = resource.data.playerCount;
        let newCount = request.resource.data.playerCount;
        return resource.data.status == "lobby"
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["playerCount", "updatedAt"])
          && request.resource.data.updatedAt == request.time
          && (newCount == previousCount || newCount == previousCount + 1)
          && getAfter(playerPath(uid)).data.ownerUid == uid
          && getAfter(playerPath(uid)).data.number >= 1
          && getAfter(playerPath(uid)).data.number <= newCount;
      }

      function isLeaving() {
        let uid = request.auth.uid;
        let remainingCount = resource.data.playerCount - 1;
        return exists(playerPath(uid))
          && !existsAfter(playerPath(uid))
          && remainingCount >= 0
          && request.resource.data.playerCount == remainingCount
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "playerCount", "updatedAt", "hostUid", "status"
          ])
          && ((remainingCount == 0
              && request.resource.data.status == "cancelled"
              && request.resource.data.hostUid == resource.data.hostUid)
            || (remainingCount > 0
              && request.resource.data.status == resource.data.status
              && existsAfter(playerPath(request.resource.data.hostUid))
              && getAfter(playerPath(request.resource.data.hostUid)).data.number
                  == 1));
      }

      function isStarting() {
        return resource.data.hostUid == request.auth.uid
          && resource.data.status == "lobby"
          && request.resource.data.status == "in_progress"
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.playerCount == resource.data.playerCount
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt"]);
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && hasValidGameFields()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == "lobby"
        && request.resource.data.playerCount == 1
        && getAfter(playerPath(request.auth.uid)).data.ownerUid
            == request.auth.uid
        && getAfter(playerPath(request.auth.uid)).data.number == 1
        && request.resource.data.currentRound == 1
        && request.resource.data.totalRounds > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated()
        && (isJoining() || isLeaving() || isStarting());
      allow delete: if false;

      match /players/{playerId} {
        function gameBefore() {
          return get(
            /databases/$(database)/documents/games/$(gameId)
          ).data;
        }

        function gameAfter() {
          return getAfter(
            /databases/$(database)/documents/games/$(gameId)
          ).data;
        }

        function ownsPlayer() {
          return isAuthenticated() && playerId == request.auth.uid;
        }

        function hasValidPlayerFields() {
          return request.resource.data.keys().hasAll([
            "ownerUid", "nickname", "avatarId", "score", "number"
          ]) && request.resource.data.keys().hasOnly([
            "ownerUid", "nickname", "avatarId", "score", "number"
          ]);
        }

        function isRenumberingAfterDeparture() {
          return gameAfter().playerCount == gameBefore().playerCount - 1
            && !existsAfter(playerPath(request.auth.uid))
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["number"])
            && request.resource.data.number is int
            && request.resource.data.number >= 1
            && request.resource.data.number <= gameAfter().playerCount;
        }

        allow read: if isAuthenticated();
        allow create: if ownsPlayer()
          && hasValidPlayerFields()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.score == 0
          && request.resource.data.number is int
          && request.resource.data.number >= 1
          && request.resource.data.number <= gameAfter().playerCount
          && gameAfter().status == "lobby";
        allow update: if (ownsPlayer()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.score == resource.data.score
            && request.resource.data.number == resource.data.number
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["nickname", "avatarId"])
            && gameAfter().status == "lobby")
          || (isAuthenticated() && isRenumberingAfterDeparture());
        allow delete: if ownsPlayer()
          && resource.data.ownerUid == request.auth.uid
          && gameAfter().playerCount == gameBefore().playerCount - 1;
      }
    }
  }
}
